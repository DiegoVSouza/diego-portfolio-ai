{
  "name": "lab-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 44173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e scripts functions",
    "test": "vitest run",
    "catalog:gen": "node scripts/catalog.mjs gen",
    "catalog:check": "node scripts/catalog.mjs check",
    "budget": "node scripts/budget.mjs",
    "e2e": "playwright test",
    "evidence:gen": "node scripts/evidence.mjs gen",
    "evidence:check": "node scripts/evidence.mjs check",
    "flow:gen": "node scripts/flows.mjs gen",
    "flow:check": "node scripts/flows.mjs check",
    "flow:mermaid": "node scripts/flows.mjs mermaid",
    "og": "node scripts/og.mjs"
  },
  "dependencies": {
    "colagem-ui": "file:vendor/colagem-ui-0.4.1.tgz",
    "preact": "10.29.2",
    "preact-render-to-string": "6.6.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "elkjs": "0.12.1",
    "eslint": "10.14.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
